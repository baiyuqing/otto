# Feature worktrees: `git worktree add .worktree/<name> -b feat/...`
.worktree/
.worktrees/
.superpowers/
/kite
/dist/
# Built web UI: `make ui` writes here; only the placeholder is tracked.
ui/dist/*
!ui/dist/.gitkeep
ui/node_modules/
.DS_Store
.kite/
*.test

# Rust build artifacts and the generated wasm package.
target/
crates/kite-web/pkg/

# Secrets — never commit credentials or config that may hold them.
# Defensive/broad on purpose: better to ignore too much than leak one file.

# Environment / dotenv
.env
.env.*
*.env
!.env.example
!.env.sample
!.env.template

# Local config that may embed secrets
config.toml
*.local.toml
secrets.*
*.secret
*.secrets
.secrets/

# Private keys, certificates, keystores
*.pem
*.key
*.p12
*.pfx
*.pkcs12
*.jks
*.keystore
*.asc
*.gpg
*.ppk

# SSH
.ssh/
id_rsa*
id_ed25519*
id_ecdsa*
id_dsa*

# Cloud / service credentials
.netrc
.pgpass
.htpasswd
.npmrc
.pypirc
.aws/
.gcp/
*-service-account*.json
service-account*.json
gcloud-*.json
kubeconfig
*.kubeconfig
.kube/config

# Token / credential dumps
*.token
credentials.json
credentials

# Provider trace dumps: `kite --trace` output holds full request bodies.
trace*.jsonl
