# Feature worktrees: `git worktree add .worktree/<name> -b feat/...`
.worktree/
.worktrees/
.superpowers/
/otto
/dist/
.DS_Store
.otto/
!.otto/
!.otto/skills/
!.otto/skills/sandbox-setup/
!.otto/skills/sandbox-setup/SKILL.md
!.otto/skills/rust-best-practices/
!.otto/skills/rust-best-practices/**
*.test

# Rust build artifacts.
target/

# Secrets — never commit credentials or config that may hold them.
# Defensive/broad on purpose: better to ignore too much than leak one file.

# Environment / dotenv
.env
.env.*
*.env
!.env.example
!.env.sample
!.env.template

# Launcher configuration read by scripts/otto.sh: kept out of Git, including
# variants such as otto.env.local. otto.env.example is the committed template.
otto.env
otto.env.*
!otto.env.example

# Local config that may embed secrets
config.toml
*.local.toml
secrets.*
*.secret
*.secrets
.secrets/

# Private keys, certificates, keystores
*.pem
*.key
*.p12
*.pfx
*.pkcs12
*.jks
*.keystore
*.asc
*.gpg
*.ppk

# SSH
.ssh/
id_rsa*
id_ed25519*
id_ecdsa*
id_dsa*

# Cloud / service credentials
.netrc
.pgpass
.htpasswd
.npmrc
.pypirc
.aws/
.gcp/
*-service-account*.json
service-account*.json
gcloud-*.json
kubeconfig
*.kubeconfig
.kube/config

# Token / credential dumps
*.token
credentials.json
credentials

# Provider trace dumps: `otto --trace` output holds full request bodies.
trace*.jsonl

# Persistent local workspace identity must not be cloned through Git.
.otto/workspace.json
