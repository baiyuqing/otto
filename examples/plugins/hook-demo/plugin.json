{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "hook-demo",
  "version": "1.0.0",
  "description": "A hook and custom tool using Python's standard library.",
  "extensions": {
    "dev.otto": {
      "version": 1,
      "hooks": {
        "before_tool": [{
          "matcher": ["plugin__hook-demo__workspace_info"],
          "command": ["python3", "${PLUGIN_ROOT}/demo.py"],
          "timeout": "5s"
        }]
      },
      "tools": [{
        "name": "workspace_info",
        "description": "List workspace entries with a label. Use label 'blocked' to demonstrate hook rejection.",
        "command": ["python3", "${PLUGIN_ROOT}/demo.py"],
        "timeout": "5s",
        "input_schema": {
          "type": "object",
          "properties": {"label": {"type": "string", "minLength": 1, "maxLength": 64}},
          "required": ["label"],
          "additionalProperties": false
        }
      }]
    }
  }
}
