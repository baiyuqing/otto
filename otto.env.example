# Launcher configuration for scripts/otto.sh and `make run`.
#
# Copy this file to otto.env in the same directory and edit it:
#
#   cp otto.env.example otto.env
#
# otto.env is ignored by Git. The launcher sources it as a shell file, so
# KEY=VALUE, quoting, `#` comments and `export` all work; it is trusted local
# configuration, exactly like a shell profile. Never put a real key in *this*
# example file, which is committed.
#
# Every setting is optional. An empty setting means "say nothing", so Otto
# falls back to its own configuration (`otto setup`, config.toml) and to the
# surrounding shell environment. Options written on the command line come last
# and win over the file:
#
#   scripts/otto.sh --model chatgpt/other-model --cwd ~/other-project

# Provider API key. Otto has no key option, so this variable is passed through
# the environment: either OTTO_API_KEY, or the variable named by the selected
# provider's api_key_env. The built-in claude provider reads ANTHROPIC_API_KEY;
# add that assignment to your ignored copy when selecting a claude/ model.
OTTO_API_KEY=

# Model selector "<provider>/<model_id>", for example chatgpt/gpt-5.6-sol. The
# provider is a [providers.<name>] table in config.toml or one of the built-in
# providers claude, openai-compatible and chatgpt. Empty uses default_model.
OTTO_MODEL=

# Deprecated but still accepted.
# OTTO_PROVIDER with a bare model ID in OTTO_MODEL equals
# OTTO_MODEL=<provider>/<model_id>; OTTO_PROFILE names a [profiles] entry.
OTTO_PROVIDER=
OTTO_PROFILE=

# Provider endpoint, for Claude or openai-compatible providers.
OTTO_BASE_URL=

# Workspace directory for the session. Empty uses the current directory.
OTTO_CWD=

# Frontend mode: auto, tui or repl.
OTTO_UI=

# Sandbox mode: auto, seatbelt (macOS) or off. `off` is explicitly unsafe.
OTTO_SANDBOX=

# Thinking effort: low, medium, high, xhigh or max.
OTTO_THINKING=

# Shell command timeout (Go duration, for example 120s) and the maximum tool
# output size in bytes.
OTTO_SHELL_TIMEOUT=
OTTO_MAX_OUTPUT_BYTES=

# Extra options appended verbatim, split on whitespace, for example
# OTTO_EXTRA_ARGS="--no-session".
OTTO_EXTRA_ARGS=

# The bearer token of a remote memory service (`[memory] backend = "remote"`)
# is a secret and is not listed here: export OTTO_MEM_TOKEN, or the variable
# named by `[memory.remote] token_env`, in the shell that starts Otto, or keep
# it in your own ignored copy of this file.

# ---- The serve and connect stack (scripts/otto-serve-connect.sh) ----
#
# `scripts/otto-serve-connect.sh start` runs one `otto serve` on its Unix
# socket and one `otto-connect` whose connect.toml sets
# `[agent] command = ["otto", "acp", "--attach"]`. It reads the settings above,
# so the model, base URL, workspace, sandbox and thinking effort are shared with
# the launcher; OTTO_UI and OTTO_EXTRA_ARGS do not apply, because `otto serve`
# rejects --ui and --prompt, and OTTO_SERVE_EXTRA_ARGS replaces the latter.
# No token is involved: the socket file is mode 0600 in a private directory.

# Unix socket `otto serve --socket` binds and connect attaches to. Absolute
# path. When it is not the default, connect.toml's `[agent].command` must add
# `"--socket", "<path>"`. Empty uses ~/.otto/otto.sock.
OTTO_SERVE_CONNECT_SOCKET=

# connect.toml the stack starts. Empty uses ~/.config/otto/connect.toml.
OTTO_CONNECT_CONFIG=

# Optional HTTP listener for serve (`--listen`), for `otto --attach` over TCP
# and the web UI. The Unix socket is bound either way.
OTTO_LISTEN=

# Extra `otto serve` options appended verbatim, split on whitespace.
OTTO_SERVE_EXTRA_ARGS=

# State and log directory of the stack. Empty uses
# ${XDG_STATE_HOME:-$HOME/.local/state}/otto-serve-connect.
OTTO_SERVE_CONNECT_HOME=
