# Launcher configuration for scripts/otto.sh and `make run`.
#
# Copy this file to otto.env in the same directory and edit it:
#
#   cp otto.env.example otto.env
#
# otto.env is ignored by Git. The launcher sources it as a shell file, so
# KEY=VALUE, quoting, `#` comments and `export` all work; it is trusted local
# configuration, exactly like a shell profile. Never put a real key in *this*
# example file, which is committed.
#
# Every setting is optional. An empty setting means "say nothing", so Otto
# falls back to its own configuration (`otto setup`, profiles) and to the
# surrounding shell environment. Options written on the command line come last
# and win over the file:
#
#   scripts/otto.sh --model other-model --cwd ~/other-project

# Provider API key. Otto has no key option, so this variable is passed through
# the environment: either OTTO_API_KEY, or the variable named by the selected
# profile's api_key_env.
OTTO_API_KEY=

# Provider, model and profile — the same names Otto itself reads. The provider
# is openai-compatible or chatgpt; the model is an ID your account can use.
OTTO_PROVIDER=
OTTO_MODEL=
OTTO_PROFILE=

# Provider endpoint, for openai-compatible providers.
OTTO_BASE_URL=

# Workspace directory for the session. Empty uses the current directory.
OTTO_CWD=

# Frontend mode: auto, tui or repl.
OTTO_UI=

# Sandbox mode: auto, seatbelt (macOS) or off. `off` is explicitly unsafe.
OTTO_SANDBOX=

# Thinking effort: low, medium, high, xhigh or max.
OTTO_THINKING=

# Shell command timeout (Go duration, for example 120s) and the maximum tool
# output size in bytes.
OTTO_SHELL_TIMEOUT=
OTTO_MAX_OUTPUT_BYTES=

# Extra options appended verbatim, split on whitespace, for example
# OTTO_EXTRA_ARGS="--no-session".
OTTO_EXTRA_ARGS=
